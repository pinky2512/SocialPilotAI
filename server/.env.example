# Social Pilot AI — example environment file.
# Copy this to `.env` (in the server/ folder) and fill in real values.
# `.env` is gitignored; this .example file is safe to commit.
# Any key left blank/placeholder falls back to simulated/placeholder behaviour.

# --- OpenAI (real AI content + image generation/restyle) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- LinkedIn (real posting) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/social/linkedin/callback

# --- SendGrid (real email) ---
SENDGRID_API_KEY=
SENDGRID_FROM=
SENDGRID_FROM_NAME=Social Pilot AI
# Shared secret for the SendGrid Event Webhook (real-time opens/clicks). Pick any
# random string and put the same value in the webhook URL's ?secret= parameter.
SENDGRID_WEBHOOK_SECRET=
# Optional: default recipients that pre-fill the campaign form (comma separated),
# so you don't retype your test addresses every time.
DEFAULT_EMAIL_RECIPIENTS=
